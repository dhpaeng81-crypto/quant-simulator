  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.8",
    "vite": "^6.4.6"
