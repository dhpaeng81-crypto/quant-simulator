{
  "name": "quant-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "한국 대형주 다음 거래일 전망 — 실데이터로 학습한 회귀 모델과 워크포워드 백테스트 (정적 사이트)",
  "scripts": {
